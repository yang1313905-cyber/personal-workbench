# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# 运行数据：默认全部忽略，但**保留**云端网页版需要读取的内容——
# 简报存档 data/output/ 与运行状态 data/status/status.json
# （state.db、日志、登录失败记录等仍不入库）
data/*
!data/output/
!data/status/
data/status/*
!data/status/status.json

# 密钥
.env
.streamlit/secrets.toml
# 配置文件备份（可能含密钥，如 .env.bak）
*.bak

# 编辑器/系统
.DS_Store
.idea/
.vscode/
