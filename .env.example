# ============ LLM（OpenAI 兼容接口）============
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# Moonshot:    https://api.moonshot.cn/v1
# 本地 Ollama: 不填 KEY，base_url 改为 http://localhost:11434/v1，model 改为 llama3 等
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ============ 推送渠道（按需填写，config.yaml 中 enabled: true 才会启用）============
# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=你的chat_id

# 企业微信群机器人
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# 飞书 / 钉钉
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx

# SMTP 邮件（QQ/163/Gmail 用授权码，不是登录密码）
SMTP_USER=you@qq.com
SMTP_PASSWORD=你的授权码
SMTP_FROM=you@qq.com
SMTP_TO=you@qq.com

# 通用 Webhook：微信推送三选一
# Server酱3（免费 5 条/天）：https://sct.ftqq.com 获取 SendKey
SENDKEY=SCTxxxxxxxxxxxxxxxx
# PushPlus（免费 200 条/天）：https://www.pushplus.plus 登录后获取 token
PUSHPLUS_TOKEN=xxxxxxxx
# WxPusher（免费，需关注公众号）：https://wxpusher.zjiecode.com
WXPUSHER_APP_TOKEN=AT_xxxxxxxx
WXPUSHER_UID=UID_xxxxxxxx
# Bark（iOS 推送）
BARK_KEY=xxxxxxxx

# ============ 可选：代理（抓取被墙源时）============
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
